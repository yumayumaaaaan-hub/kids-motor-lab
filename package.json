{
  "name": "hiragana-writing-practice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "copy:cars": "powershell -ExecutionPolicy Bypass -File scripts/copy-car-images.ps1",
    "generate:data": "node scripts/generate-game-data.mjs",
    "download:japan-cars": "powershell -ExecutionPolicy Bypass -File ../nenchu-car-get/download-japan-car-images.ps1",
    "download:japan-cars:retry": "powershell -ExecutionPolicy Bypass -File ../nenchu-car-get/download-japan-car-images-curl.ps1",
    "dev": "vite --host",
    "dev:local": "powershell -ExecutionPolicy Bypass -File scripts/start-dev.ps1",
    "deploy:cf": "powershell -Command \"$env:CF_PAGES='1'; npm run build; npx wrangler pages deploy dist --project-name=kids-motor-lab\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
